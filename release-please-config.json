{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "initial-version": "1.0.0",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Changed"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "revert",
          "section": "Reverted"
        },
        {
          "type": "build",
          "hidden": true
        },
        {
          "type": "chore",
          "hidden": true
        },
        {
          "type": "ci",
          "hidden": true
        },
        {
          "type": "style",
          "hidden": true
        },
        {
          "type": "test",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "Configs/Version.xcconfig"
        }
      ]
    }
  }
}
